FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.web.runtime.txt /tmp/requirements.web.runtime.txt
RUN pip install --no-cache-dir -r /tmp/requirements.web.runtime.txt

COPY src /app/src

ENV PYTHONPATH=/app \
    OUT_DIR=/data \
    WEB_PORT=8081

EXPOSE 8081

CMD ["uvicorn", "src.web_api:app", "--host", "0.0.0.0", "--port", "8081"]
