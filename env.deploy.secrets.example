# Deploy-time secrets
# Used by scripts/deploy/csv_deploy_container.py and GitHub Actions sync.
# This file should NOT be committed after you copy it to `.env.deploy.secrets`.

# GHCR token (only needed for private GHCR images)
GHCR_TOKEN=

# Portainer stack webhook token (token tail only, not full URL)
PORTAINER_WEBHOOK_TOKEN=

# Optional: Portainer API auth for automatic stack deployment / webhook self-heal
PORTAINER_ACCESS_TOKEN=
