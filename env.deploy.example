# Deploy-time environment variables
# Used by scripts/deploy/csv_deploy_container.py - NOT uploaded to Key Vault

# Azure authentication (set via 'az login' or GitHub Actions OIDC)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Required: Azure AD App Registration display name to use/ensure for GitHub Actions OIDC
AZURE_OIDC_APP_NAME=

# Resource configuration
AZURE_RESOURCE_GROUP=camera-storage-viewer-rg
AZURE_LOCATION=westeurope

# Optional naming overrides
# If unset, the deploy script will use schema defaults.
AZURE_CONTAINER_NAME=camera-storage-viewer
# If unset, the deploy script will derive a DNS label from the container name.
AZURE_DNS_LABEL=

# Container images
APP_IMAGE=ghcr.io/beejones/camera-storage-viewer:latest

# Optional: deployment customization hooks
# By default, the deploy script will auto-load viewer hooks from:
#   scripts/deploy/deploy_customizations.py
# You can override it at runtime via CLI flags on scripts/deploy/csv_deploy_container.py:
#   --hooks-module <module-or-path>
#   --hooks-soft-fail

# Optional: override the Caddy image used in ACI.
# Useful if Docker Hub pulls fail/rate-limit.
# Example:
# CADDY_IMAGE=ghcr.io/caddyserver/caddy:2
CADDY_IMAGE=caddy:2-alpine

# Optional sizing overrides (defaults are used if unset)
APP_CPU_CORES=1.0
APP_MEMORY_GB=2.0
CADDY_CPU_CORES=0.5
CADDY_MEMORY_GB=0.5

# Domain and TLS
# Web will be deployed behind Caddy with HTTPS for this domain.
PUBLIC_DOMAIN=
# Optional but recommended for ACME registration / expiry notices
ACME_EMAIL=
# GHCR credentials (for private GHCR images)
# Set GHCR_PRIVATE=true if your GHCR package is private.
# If GHCR_USERNAME and GHCR_TOKEN are set, deploy will include registry credentials in the ACI YAML.
GHCR_PRIVATE=false
GHCR_USERNAME=

GHCR_TOKEN=
