# Runtime secrets
# These are uploaded to Azure Key Vault as the 'env-secrets' secret

# Required if you deploy behind Caddy with Basic Auth
BASIC_AUTH_HASH=

# Optional app secret (user-defined; only used if your runtime needs it)
APP_SECRET=

# Option B: multi-camera credentials (recommended)
FTP_USERS_JSON=

# Option A: single camera credentials
FTP_CAMERA_ID=camera1
FTP_USERNAME=
FTP_PASSWORD=
