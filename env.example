# Runtime environment variables
# These are uploaded to Azure Key Vault as the 'env' secret

# Put secrets/credentials in `.env.secrets` (see env.secrets.example).


# FTP server (camera uploads)
#
# Minimum config (single camera):
# - set FTP_USERNAME / FTP_PASSWORD / FTP_CAMERA_ID
#
# Multi-camera config: set FTP_USERS_JSON to a JSON list, e.g.
#   FTP_USERS_JSON=[{"camera_id":"front","username":"front","password":"..."},{"camera_id":"back","username":"back","password":"..."}]

# Durable mount (Azure Files in prod, bind-mount ./out locally)
OUT_DIR=/data

# Viewer index DB / SQLite tuning
#
# By default, the viewer stores its rebuildable index DB under OUT_DIR.
# On Azure (when AZURE_KEYVAULT_URI is set and OUT_DIR=/data), the app defaults to a local
# ephemeral index DB under /tmp to avoid Azure Files (SMB) SQLite issues.
# You can override explicitly:
#   INDEX_DB_PATH=/tmp/camera-storage-viewer/databases/index.sqlite
#   INDEX_DB_PATH=databases/index.sqlite  (relative to OUT_DIR)
INDEX_DB_PATH=

# Optional: lock path used to serialize index refresh/writes.
# Empty means "next to the DB".
INDEX_LOCK_PATH=

# Refresh index at most once per TTL (seconds). 0 = every request.
INDEX_REFRESH_TTL_SECONDS=30

# SQLite settings (env-tunable). Defaults are chosen for network filesystem safety.
SQLITE_JOURNAL_MODE=DELETE
SQLITE_SYNCHRONOUS=FULL
SQLITE_BUSY_TIMEOUT_MS=5000

FTP_BIND_HOST=0.0.0.0
FTP_PORT=21

# Public hostname/IP for PASV replies (set this in Azure; optional locally)
FTP_PUBLIC_HOST=

# Passive port range (must be opened on ACI)
FTP_PASSIVE_PORT_MIN=50000
FTP_PASSIVE_PORT_MAX=50003

# Some clients (and some NAT/load balancers) may open the data connection from a different
# source IP than the control connection. If you see server logs like:
#   Rejected data connection from foreign address
# keep this enabled.
FTP_PERMIT_FOREIGN_ADDRESSES=true

# Optional overrides
FTP_INCOMING_DIR=
FTP_SPOOL_DIR=

# Local dev convenience (do not use in production)
FTP_DEV_DEFAULTS=false

